<Window x:Class="TangerineWin.Views.PdfToPowerPointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF → PowerPoint"
        Width="450"
        Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        Foreground="White"
        Topmost="True">

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="Экспорт PDF в PowerPoint"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Выберите способ переноса страниц"
                       Foreground="#FF9B9BA1"
                       FontSize="12"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14"
                CornerRadius="8"
                Background="#FF292A2E"
                BorderBrush="#30FFFFFF"
                BorderThickness="1">

            <StackPanel>

                <RadioButton x:Name="EditableRadio"
                             GroupName="ExportMode"
                             IsChecked="True"
                             Margin="0,0,0,16">

                    <StackPanel Margin="7,0,0,0">

                        <TextBlock Text="Редактируемая презентация"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Текст, таблицы и изображения будут переноситься отдельными объектами"
                                   Foreground="#FF92939A"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </RadioButton>

                <RadioButton x:Name="ExactRadio"
                             GroupName="ExportMode">

                    <StackPanel Margin="7,0,0,0">

                        <TextBlock Text="Точное отображение"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Каждая страница PDF будет перенесена на слайд как изображение"
                                   Foreground="#FF92939A"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </RadioButton>

            </StackPanel>

        </Border>

        <TextBlock Grid.Row="2"
                   Text="Редактируемый режим может отличаться от исходной верстки PDF."
                   Foreground="#FF77787E"
                   FontSize="11"
                   VerticalAlignment="Top"
                   Margin="0,12,0,0"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Отмена"
                    Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    IsCancel="True"/>

            <Button Content="Экспортировать"
                    Width="120"
                    Height="34"
                    IsDefault="True"
                    Click="OnExportClick"/>

        </StackPanel>

    </Grid>

</Window>