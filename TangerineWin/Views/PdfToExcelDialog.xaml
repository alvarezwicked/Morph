<Window x:Class="TangerineWin.Views.PdfToExcelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF → Excel"
        Width="430"
        Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        Foreground="White"
        Topmost="True">

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="Экспорт PDF в Excel"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Выберите, какие данные перенести в XLSX"
                       Foreground="#FF9B9BA1"
                       FontSize="12"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14"
                CornerRadius="8"
                Background="#FF292A2E"
                BorderBrush="#30FFFFFF"
                BorderThickness="1">

            <StackPanel>

                <RadioButton x:Name="TablesOnlyRadio"
                             GroupName="ExportMode"
                             Margin="0,0,0,14">

                    <StackPanel Margin="7,0,0,0">

                        <TextBlock Text="Только таблицы"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="В Excel попадут только найденные таблицы"
                                   Foreground="#FF92939A"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </RadioButton>

                <RadioButton x:Name="TextAndTablesRadio"
                             GroupName="ExportMode"
                             IsChecked="True">

                    <StackPanel Margin="7,0,0,0">

                        <TextBlock Text="Таблицы и текст"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Текст и таблицы будут перенесены на один лист в порядке документа"
                                   Foreground="#FF92939A"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </RadioButton>

            </StackPanel>

        </Border>

        <TextBlock Grid.Row="2"
                   Text="Для сканированных PDF будет использоваться OCR."
                   Foreground="#FF77787E"
                   FontSize="11"
                   VerticalAlignment="Top"
                   Margin="0,12,0,0"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Отмена"
                    Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    IsCancel="True"/>

            <Button Content="Экспортировать"
                    Width="120"
                    Height="34"
                    IsDefault="True"
                    Click="OnExportClick"/>

        </StackPanel>

    </Grid>

</Window>