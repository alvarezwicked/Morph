<Window x:Class="TangerineWin.Views.DeletePagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Pages"
        Width="360"
        Height="190"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Какие страницы удалить?"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">

            <TextBox x:Name="RangeTextBox"
                     Height="32"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Например: 2,4-6"
                       Foreground="Gray"
                       FontSize="12"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">

            <Button Content="Отмена"
                    Width="80"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="OnCancelClick"/>

            <Button Content="Удалить"
                    Width="90"
                    Height="30"
                    IsDefault="True"
                    Click="OnDeleteClick"/>

        </StackPanel>
    </Grid>
</Window>