<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>

		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<AssemblyName>Morph</AssemblyName>
		<RootNamespace>TangerineWin</RootNamespace>

		<Product>Morph</Product>
		<Title>Morph</Title>

		<Company>vincente.soft</Company>
		<Authors>vincente.soft</Authors>

		<Description>A fast radial file converter for Windows</Description>

		<Copyright>© 2026 vincente.soft</Copyright>

		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>

		<ApplicationIcon>Assets\Morph.ico</ApplicationIcon>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="Docnet.Core" Version="2.6.0" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
		<PackageReference Include="PdfPig" Version="0.1.16" />
		<PackageReference Include="Tabula" Version="1.0.1" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
	</ItemGroup>


	<ItemGroup>
		<None Update="tessdata\*.traineddata">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>


	<ItemGroup>
		<None Update="Assets\PdfTemplate.pptx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>